  "version": "0.2.0",
  "configurations": [
    {
      "name": "Build & Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "/home/lotha/.local/share/uv/tools/pebble-tool/bin/pebble",
      "args": [ "install", "--emulator", "emery",],
      "stopAtEntry": true,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
          {
              "description": "Activer l'impression en mode Pretty pour gdb",
              "text": "-enable-pretty-printing",
              "ignoreFailures": true
          }
      ],
      "preLaunchTask": "build",
      "miDebuggerPath": "/usr/bin/gdb"
    }
  ]
}